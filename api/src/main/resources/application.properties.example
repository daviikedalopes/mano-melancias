spring.application.name=api

spring.datasource.url=jdbc:postgresql://localhost:5432/manomelancias?currentSchema=public
spring.datasource.username=CHANGE_ME
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=America/Sao_Paulo

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

app.jwt.secret=${JWT_SECRET:CHANGE_ME_pelo_menos_32_caracteres}
app.jwt.expiration-minutes=${JWT_EXPIRATION_MINUTES:480}
app.cors.allowed-origins=http://localhost:5500,http://127.0.0.1:5500,http://localhost:63342
