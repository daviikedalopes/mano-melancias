# Normalmente você NÃO preenche este arquivo à mão: no servidor, rode
#   bash gerar-env.sh SEU_DOMINIO
# que cria o ".env" com segredos aleatórios. Este modelo só documenta as variáveis.
# O ".env" nunca vai para o git.

# Domínio apontado para o IP do servidor (ou IP-COM-TRACOS.sslip.io para testes; localhost para testar local)
DOMINIO=exemplo.com.br

# Senha do PostgreSQL — gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Segredo de assinatura do login — gere com: openssl rand -hex 48
JWT_SECRET=

# Validade do login em minutos (480 = 8 horas)
JWT_EXPIRATION_MINUTES=480

# Opcional, para o backup.sh enviar uma cópia para fora do servidor (rclone, ex.: "r2:meu-bucket/mano")
# BACKUP_RCLONE_REMOTE=
